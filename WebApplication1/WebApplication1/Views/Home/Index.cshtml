@{
    ViewData["Title"] = "Domů";
}

<section class="hero">
    <h1>Vítejte ve světě Epic Eats!</h1>
    <p class="subtitle">Objevte nejšílenější food challenges a mukbang momenty</p>
</section>

<section class="intro">
    <h2>Co je Mukbang?</h2>
    <p>Mukbang je fenomén, který pochází z Jižní Koreje a doslova znamená "vysílání jídla". Lidé natáčejí sami sebe, jak konzumují obrovské množství jídla, zatímco komunikují se svými diváky. Je to fascinující spojení zábavy, komunity a někdy i extrémního výkonu.</p>

    <div class="features">
        <div class="feature-box">
            <h3>🍕 Food Challenges</h3>
            <p>Extrémní výzvy, kde se jedí obří porce za časový limit</p>
        </div>
        <div class="feature-box">
            <h3>🎥 Mukbang Show</h3>
            <p>Relaxační sledování jídla s komentářem a interakcí</p>
        </div>
        <div class="feature-box">
            <h3>🌍 Celosvětový Trend</h3>
            <p>Miliony fanoušků po celém světě sledují tyto videa</p>
        </div>
    </div>
</section>

<section class="mukbang-types">
    <h2>🍜 Populární Mukbang Styly</h2>
    <table class="mukbang-table">
        <thead>
            <tr>
                <th>Typ Mukbangu</th>
                <th>Oblíbené Jídlo</th>
                <th>Původ</th>
                <th>Popularita</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>ASMR Mukbang</td>
                <td>Pikantní nudle, smažené kuře</td>
                <td>Jižní Korea</td>
                <td>⭐⭐⭐⭐⭐</td>
            </tr>
            <tr>
                <td>Fast Food Mukbang</td>
                <td>Burgery, pizza, hranolky</td>
                <td>USA</td>
                <td>⭐⭐⭐⭐</td>
            </tr>
            <tr>
                <td>Seafood Mukbang</td>
                <td>Krab, humr, ústřice</td>
                <td>Jižní Korea</td>
                <td>⭐⭐⭐⭐⭐</td>
            </tr>
            <tr>
                <td>Dessert Mukbang</td>
                <td>Dorty, zmrzlina, sladkosti</td>
                <td>Celosvětově</td>
                <td>⭐⭐⭐⭐</td>
            </tr>
        </tbody>
    </table>
</section>

<section class="latest">
    <h2>Nejnovější Trendy</h2>
    <div class="trend-grid">
        <div class="trend-item">
            <div class="trend-image">
                <img src="~/images/challenge1.jpg" alt="Spicy Noodle Challenge">
            </div>
            <h3>Spicy Noodle Challenge</h3>
            <p>Nejpopulárnější výzva posledních let - kdo vydrží nejpálivější nudle?</p>
        </div>
        <div class="trend-item">
            <div class="trend-image">
                <img src="~/images/challenge2.jpg" alt="Giant Burger Challenge">
            </div>
            <h3>Giant Burger Challenge</h3>
            <p>Burgery vážící několik kilogramů - dokážete to sníst za hodinu?</p>
        </div>
    </div>
</section>
