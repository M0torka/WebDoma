@model List<WebApplication1.Models.Note>

<h2>Moje poznámky</h2>
<a asp-action="Add">+ Přidat poznámku</a>

@if (!Model.Any())
{
    <p>Zatím žádné poznámky.</p>
}
else
{
    foreach (var note in Model)
    {
        <div>
            <h3>@note.Title</h3>
            <p>@note.Content</p>
            <small>@note.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
        </div>
    }
}