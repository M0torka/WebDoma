<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Epic Eats</title>
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body>
    <header>
        <nav>
            <div class="logo">🍔 Epic Eats</div>
            <div class="nav-account">
                <ul class="nav-links">
                    <li>
                        <a asp-controller="Home" asp-action="Index"
                           class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                            Domů
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Home" asp-action="Challenges"
                           class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Challenges" ? "active" : "")">
                            Top Challenges
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Home" asp-action="OMne"
                           class="@(ViewContext.RouteData.Values["action"]?.ToString() == "OMne" ? "active" : "")">
                            O mně
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Home" asp-action="Recenze"
                           class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Recenze" ? "active" : "")">
                            Recenze
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Home" asp-action="Ucet"
                           class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Ucet" ? "active" : "")">
                            Účet
                        </a>
                    </li>
                </ul>

                <a asp-controller="Home" asp-action="Ucet" class="account-avatar">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <img src="~/images/prihlasen1.png" alt="Přihlášen" />
                    }
                    else
                    {
                        <img src="~/images/prihlasen0.png" alt="Nepřihlášen" />
                    }
                </a>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <p>&copy; 2024 Epic Eats | Autor: Honza H.</p>
    </footer>
</body>
</html>
