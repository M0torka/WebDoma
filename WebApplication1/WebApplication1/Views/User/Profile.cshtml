@{
    ViewData["Title"] = "Můj profil";
}

<div class="container">
    <div class="row">
        <div class="col-md-8">
            <h2>Můj profil</h2>
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Informace o profilu</h5>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <p><strong>Uživatelské jméno:</strong></p>
                            <p>Vaše uživatelské jméno</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>E-mail:</strong></p>
                            <p>vůš-email@example.com</p>
                        </div>
                    </div>
                    <div class="mb-3">
                        <p><strong>Datum registrace:</strong></p>
                        <p>01.01.2024</p>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <h4>Nastavení</h4>
                <div class="list-group">
                    <a href="#" class="list-group-item list-group-item-action">Změnit heslo</a>
                    <a href="#" class="list-group-item list-group-item-action">Změnit e-mail</a>
                    <a href="#" class="list-group-item list-group-item-action">Nastavení privátnosti</a>
                </div>
            </div>

            <div class="mt-4">
                <a href="#" class="btn btn-danger">Odhlásit se</a>
                <a href="/" class="btn btn-secondary">Zpět na domovskou stránku</a>
            </div>
        </div>
    </div>
</div>
