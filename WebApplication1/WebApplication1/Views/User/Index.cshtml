@{
    ViewData["Title"] = "Účet";
}

@if (User.Identity == null || !User.Identity.IsAuthenticated)
{
    <script>window.location.href = "/User/Register";</script>
}
else
{
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>@TempData["SuccessMessage"]</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <section class="page-header">
        <h1>👤 Můj účet</h1>
        <p class="subtitle">Vítej zpět, @User.Identity.Name!</p>
    </section>

    <section class="account-lobby">
        <a class="account-card disabled" href="#">
            <div class="account-card-icon">⚙️</div>
            <div class="account-card-body">
                <h3>Nastavení</h3>
                <p>Upravit profil, heslo a předvolby účtu</p>
            </div>
            <div class="account-card-arrow">›</div>
        </a>

        <a class="account-card disabled" href="#">
            <div class="account-card-icon">📋</div>
            <div class="account-card-body">
                <h3>Historie</h3>
                <p>Přehled navštívených výzev a mukbang videí</p>
            </div>
            <div class="account-card-arrow">›</div>
        </a>

        <a class="account-card disabled" href="#">
            <div class="account-card-icon">💬</div>
            <div class="account-card-body">
                <h3>Komentáře</h3>
                <p>Všechny tvoje komentáře na jednom místě</p>
            </div>
            <div class="account-card-arrow">›</div>
        </a>
    </section>
}
