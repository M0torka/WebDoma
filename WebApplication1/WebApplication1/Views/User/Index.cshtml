@{
    ViewData["Title"] = "Účet";
}
@{
    var isAuthenticated = Context.Session.GetString("isAuthenticated");
    var username = Context.Session.GetString("username");
}
@if (string.IsNullOrEmpty(isAuthenticated) || isAuthenticated != "true")
{
    <script>window.location.href = "/User/Register";</script>
}
else
{
    <section class="page-header">
        <h1>👤 Můj účet</h1>
        <p class="subtitle">Vítej zpět, @username!</p>
    </section>
    <section class="account-lobby">
        <a class="account-card" href="/Note/Add">
            <div class="account-card-icon">📝</div>
            <div class="account-card-body">
                <h3>Přidat poznámku</h3>
                <p>Vytvoř a ulož novou textovou poznámku</p>
            </div>
            <div class="account-card-arrow">›</div>
        </a>
        <a class="account-card" href="/Note/List">
            <div class="account-card-icon">🗒️</div>
            <div class="account-card-body">
                <h3>Moje poznámky</h3>
                <p>Zobraz všechny své uložené poznámky</p>
            </div>
            <div class="account-card-arrow">›</div>
        </a>
    </section>
}